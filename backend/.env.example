# =====================================================
# AI Smart Study Companion — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Get this from MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/AIStudy

# JWT
# Use a long random string — at least 64 characters
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Google Gemini API
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# Cloudinary (optional — for cloud PDF storage later)
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS — frontend URL
FRONTEND_URL=http://localhost:5173

# Upload limits
MAX_FILE_SIZE_MB=50
